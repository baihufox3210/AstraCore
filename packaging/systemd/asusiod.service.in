[Unit]
Description=asusio hardware daemon (lighting restore, fan curves)
Documentation=https://github.com/baihu/asusio
After=systemd-modules-load.service local-fs.target

[Service]
Type=simple
ExecStart=@BINDIR@/asusiod --config @CONFIG@
# Runs after any exit, including crashes, so fans never stay in manual mode.
ExecStopPost=@BINDIR@/asusiod --config @CONFIG@ --release-fans
Restart=on-failure
RestartSec=5
RuntimeDirectory=asusio
RuntimeDirectoryMode=0755
StateDirectory=asusio
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
