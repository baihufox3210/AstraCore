# Maintainer: baihu <baihu3210@gmail.com>
#
# Release package: builds the tagged version v$pkgver from GitHub. To release, tag the
# commit, set pkgver, refresh the checksum with `makepkg -g` and .SRCINFO with
# `makepkg --printsrcinfo > .SRCINFO`. packaging/arch builds the working tree instead.
pkgname=astracore
pkgver=0.1.0
pkgrel=1
pkgdesc="ASUS hardware I/O framework for Linux: native lighting, fan curves and the astrad service"
arch=('x86_64')
url="https://github.com/baihufox3210/AstraCore"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
conflicts=('asusio')
replaces=('asusio')
install=astracore.install
options=('!lto' '!debug')
source=("AstraCore::git+$url.git#tag=v$pkgver")
sha256sums=('6ff23d948bfdd89ee00c59d122d6f3cf13586c7c8e9cbd8decb2e538242f5758')
_name=AstraCore

prepare() {
    cd "$_name"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_name"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p astra -p astrad -p astra-helper
}

check() {
    cd "$_name"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release --workspace
}

package() {
    cd "$_name"
    install -Dm755 target/release/astra target/release/astrad target/release/astra-helper -t "$pkgdir/usr/bin/"

    sed -e 's|@BINDIR@|/usr/bin|g' -e 's|@CONFIG@|/etc/astracore/astrad.json|g' packaging/systemd/astrad.service.in |
        install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/astrad.service"
    install -Dm644 packaging/systemd/astracore.sysusers "$pkgdir/usr/lib/sysusers.d/astracore.conf"
    install -Dm644 packaging/systemd/astracore-modules.conf "$pkgdir/usr/lib/modules-load.d/astracore.conf"

    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
    install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
