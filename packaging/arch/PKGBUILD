# Local package built from this repository's working tree, for trying changes before a
# release:  cd packaging/arch && makepkg -si
# packaging/aur builds the released versions as `astracore`; this one takes its place.
pkgname=astracore-local
pkgver=0.1.0.r10.gfc2804c
pkgrel=1
pkgdesc="ASUS hardware I/O framework for Linux: native lighting, fan curves and the astrad service"
arch=('x86_64')
url="https://github.com/baihufox3210/AstraCore"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
# The project was called asusio before 2026-11-07; this package takes its place.
provides=('astracore')
conflicts=('astracore' 'asusio')
replaces=('asusio')
install=astracore.install
options=('!lto' '!debug')

_repo="$(realpath "$startdir/../..")"

pkgver() {
    local version
    version=$(sed -n 's/^version = "\(.*\)"/\1/p' "$_repo/Cargo.toml" | head -1)
    if git -C "$_repo" rev-parse --git-dir >/dev/null 2>&1; then
        printf '%s.r%s.g%s' "$version" \
            "$(git -C "$_repo" rev-list --count HEAD)" \
            "$(git -C "$_repo" rev-parse --short HEAD)"
    else
        printf '%s' "$version"
    fi
}

prepare() {
    cd "$_repo"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_repo"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --frozen --release -p astra -p astrad -p astra-helper
}

check() {
    cd "$_repo"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --frozen --release --workspace
}

package() {
    local release="$srcdir/target/release"
    install -Dm755 "$release/astra" "$release/astrad" "$release/astra-helper" -t "$pkgdir/usr/bin/"

    cd "$_repo/packaging/systemd"
    sed -e 's|@BINDIR@|/usr/bin|g' -e 's|@CONFIG@|/etc/astracore/astrad.json|g' astrad.service.in |
        install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/astrad.service"
    install -Dm644 astracore.sysusers "$pkgdir/usr/lib/sysusers.d/astracore.conf"
    install -Dm644 astracore-modules.conf "$pkgdir/usr/lib/modules-load.d/astracore.conf"

    cd "$_repo"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
    install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
